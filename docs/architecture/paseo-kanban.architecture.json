  "cards": [
    {
      "dot": "cyan",
      "title": "分层解耦与事务锁定",
      "items": [
        "表现层、手势控制器与领域计算严格分离，消除隐式依赖与跨层状态污染",
        "Transaction Baseline Locking 确保拖拽与模态编辑在冻结版本上提交，杜绝脏写"
      ]
    },
    {
      "dot": "emerald",
      "title": "原生微交互与物理引擎",
      "items": [
        "基于 React Native Animated 构建动态占位槽与飞入吸附动效，零原生编译依赖",
        "桌面端位移容差自动升级手势，触屏端长按抓起，搭配 8px 迟滞死区与边缘自动滚动"
      ]
    },
    {
      "dot": "violet",
      "title": "响应式容错与排序演算",
      "items": [
        "useProjects 配备请求乱序熔断控制，项目服务异常或慢响应不破坏看板正常交互",
        "reorderTask 纯函数支持相对锚点插值、无可见锚点相对追加与同泳道原位 No-Op"
      ]
    }
  ]
